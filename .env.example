# Скопировать в .env.dev перед запуском: cp .env.example .env.dev

# Postgres (внутри контейнера слушает штатный 5432; наружу опубликован как 5433)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=test
POSTGRES_HOST=backend-db

# Celery / Redis
CELERY_BROKER_URL=redis://backend-redis:6379/0

# Хранилище файлов: общий том backend и воркера (см. docker-compose.dev.yml)
STORAGE_DIR=/data/files

# Лимиты, байты. MAX_UPLOAD_SIZE — сверх этого загрузка отклоняется (413),
# SUSPICIOUS_SIZE — порог, с которого файл помечается подозрительным.
MAX_UPLOAD_SIZE=104857600
SUSPICIOUS_SIZE=10485760

LOG_LEVEL=INFO
